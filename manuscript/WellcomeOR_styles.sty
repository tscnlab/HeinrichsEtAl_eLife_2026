% endfloat separates every deferred float with \efloatseparator, which defaults to
% \clearpage -- one float per page. Figures are large and should keep that, but
% tables are mostly short and several should share a page. We therefore make the
% separator context-dependent: a vertical skip between tables, a page break
% between figures. \AtBeginTables/\AtBeginFigures flip the switch when endfloat
% starts emitting each block.
\newif\ifpackfloats
\packfloatsfalse
\AtBeginFigures{\packfloatsfalse}
\AtBeginTables{\packfloatstrue}
% Redefine \efloatseparator (endfloat's between-float separator, \clearpage by
% default) so the switch set by the hooks above decides. Done \AtBeginDocument
% so it wins regardless of when endfloat defines the macro. \providecommand plus
% \renewcommand keeps this working even if the macro name ever disappears.
\AtBeginDocument{%
  \providecommand{\efloatseparator}{}%
  \renewcommand{\efloatseparator}{%
    \ifpackfloats\vspace{2\baselineskip}\else\clearpage\fi}%
}

% Let a page of deferred tables fill up rather than bailing out early.
